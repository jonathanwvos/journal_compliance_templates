# ==============================================================================
# Matplotlib Stylesheet: Journal of the American Chemical Society
# Publisher: American Chemical Society (ACS)
# Guidelines: https://publish.acs.org/publish/author_guidelines?coden=jacsat
# Last Verified: 2026-09-11
# ==============================================================================
# Sizing Reference:
#   Single column width: 82.5 mm (3.25 in)
#   Double column width: 177.8 mm (7.00 in)
#   Max figure height:   235.0 mm (9.25 in)
# ==============================================================================

# Font Configuration
font.family: sans-serif
font.sans-serif: Arial, Helvetica, Times New Roman, DejaVu Sans
font.size: 7.0

# Axes & Titles
axes.labelsize: 8.0
axes.labelweight: normal
axes.titlesize: 9.0
axes.titleweight: bold
axes.titlepad: 6.0
axes.labelpad: 4.0

# Line Weights & Spines
axes.linewidth: 0.5
axes.spines.top: False
axes.spines.right: False
axes.spines.left: True
axes.spines.bottom: True

# Ticks Configuration
xtick.top: False
xtick.bottom: True
xtick.direction: out
xtick.major.size: 3.5
xtick.major.width: 0.5
xtick.minor.size: 2.0
xtick.minor.width: 0.5
xtick.labelsize: 7.0

ytick.right: False
ytick.left: True
ytick.direction: out
ytick.major.size: 3.5
ytick.major.width: 0.5
ytick.minor.size: 2.0
ytick.minor.width: 0.5
ytick.labelsize: 7.0

# Plot Lines & Markers
lines.linewidth: 1.0
lines.markersize: 4.5
lines.markeredgewidth: 0.5
patch.linewidth: 0.5

# Grid Lines
grid.linewidth: 0.25
grid.linestyle: --
grid.alpha: 0.6

# Legend Configuration
legend.fontsize: 7.0
legend.title_fontsize: 7.5
legend.frameon: False
legend.borderaxespad: 0.5
legend.handlelength: 1.5
legend.handleheight: 0.7
legend.handletextpad: 0.5

# Color Palette (Okabe-Ito - Color-Blind Safe)
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'F0E442', '56B4E9', 'E69F00', 'CC79A7', '000000'])

# Figure Canvas & DPI
figure.dpi: 300
figure.autolayout: False
figure.titlesize: 9.0
figure.titleweight: bold

# Production Export Settings (Vector & TrueType embedding)
savefig.dpi: 1200
savefig.format: pdf
savefig.bbox: tight
savefig.pad_inches: 0.02
savefig.transparent: False

# Embed TrueType / PostScript fonts directly (Do NOT rasterize to Type 3 bitmap)
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: path
